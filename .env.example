# ─────────────────────────────────────────────────────────────
# TECHMED AIS Brainstorming — Environment Variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# Supabase PostgreSQL connection string (Project Settings → Database).
# Use the "Connection pooling" (Transaction, port 6543) URL for the app at runtime.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma for migrations.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth v5
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (used for avatar/file storage — optional but recommended)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"

# Web Push (VAPID) — for PWA push notifications. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Seed admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@techmed.ng"
SEED_ADMIN_PASSWORD="Admin@12345"
